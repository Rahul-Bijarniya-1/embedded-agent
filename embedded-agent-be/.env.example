# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=goodscore-stage
GOOGLE_CLOUD_LOCATION=global
# Path to the service-account key (relative paths resolve against this folder). Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=secrets/sa.json

# --- Gemini text model: ordered fallbacks, first one that exists is used ---
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
# minimal | low | medium | high | (empty = let the model decide)
GEMINI_THINKING_LEVEL=minimal

# --- Gemini TTS ---
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
GEMINI_TTS_LOCATION=global
GEMINI_TTS_VOICE=Kore

# --- Timeouts (seconds) ---
LLM_TIMEOUT_S=30
TTS_TIMEOUT_S=45

# --- Protection ---
RATE_LIMIT_PER_MINUTE=20
# Set to 1 only behind a reverse proxy you control that overwrites X-Forwarded-For; otherwise anyone can fake it.
TRUST_FORWARDED_FOR=0
CACHE_TTL_S=600
CACHE_SIZE=256
LOG_LEVEL=INFO
